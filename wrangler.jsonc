{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xbul",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference, required by OpenNext; the service name must match the worker name.
    { "binding": "WORKER_SELF_REFERENCE", "service": "xbul" }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Paste the id printed by `pnpm wrangler hyperdrive create xbul-db …` (docs/deploy.md).
      "id": "<HYPERDRIVE_ID>",
      // `pnpm preview` connects here instead of Hyperdrive (the Docker Postgres in docs/deploy.md).
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/xbul"
    }
  ],
  // Private bucket for the documents suppliers send in for review (docs/deploy.md): never public, read only through the app.
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "xbul-evidence" }],
  // Public settings. Secrets (BETTER_AUTH_SECRET, RESEND_API_KEY, ADMIN_EMAILS) go in with `wrangler secret put`.
  // PUBLIC_BASE_URL is the one canonical origin (sign-in included): pick apex or www and use it everywhere.
  "vars": {
    "PUBLIC_BASE_URL": "https://xbul.ai",
    "MAIL_FROM": "xbul <hello@xbul.ai>"
  },
  // Workers Logs: request logs and console output (e.g. a failed owner notification) in the dashboard.
  "observability": { "enabled": true },
  // A page runs several queries, so the worker runs beside the Neon database (docs/deploy.md).
  "placement": { "region": "aws:eu-central-1" },
  "env": {
    // Test data only. Bindings and vars aren't inherited, so staging repeats each one with its own resource.
    "staging": {
      "name": "xbul-staging",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "xbul-staging" }],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "<HYPERDRIVE_STAGING_ID>",
          "localConnectionString": "postgres://postgres:postgres@localhost:5432/xbul"
        }
      ],
      "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "xbul-evidence-staging" }],
      "vars": {
        "PUBLIC_BASE_URL": "https://staging.xbul.ai",
        "MAIL_FROM": "xbul staging <hello@xbul.ai>"
      },
      "observability": { "enabled": true }
    }
  }
}
