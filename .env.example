DATABASE_URL=./.data/dev            # a path → PGlite; postgres://… → Postgres
BETTER_AUTH_SECRET=replace-with-32+-random-chars
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_EMAILS=you@example.com        # comma-separated
RESEND_API_KEY=                     # empty → console mailer
MAIL_FROM=xbul <hello@mail.xbul.io>
MAIL_LOG_FILE=.outbox/mail.log
FETCH_ALLOW_PRIVATE_HOSTS=0
EVIDENCE_DIR=./.data/evidence       # where supplier documents are kept locally; Workers use the R2 bucket instead
GOOGLE_CLIENT_ID=                   # both set → "Google" button on /sign-in (docs/deploy.md step 6a)
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=                # both set → "Microsoft" button
MICROSOFT_CLIENT_SECRET=
PHOTO_AI=fake                       # fake → a stand-in for Workers AI under pnpm dev (sizes in src/modules/photos/infrastructure/fake-photo-model.ts); empty → photo features off
PHOTO_SEARCH_PUBLIC=1               # 1 → buyers see photo search; suppliers can add photos either way
