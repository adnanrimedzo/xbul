{
  "name": "xbul",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "rm -rf .data/dev && mkdir -p .data && tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "e2e": "playwright test",
    "preview": "node scripts/no-env-files.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/no-env-files.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:staging": "node scripts/no-env-files.mjs && opennextjs-cloudflare build --env=staging && opennextjs-cloudflare deploy --env=staging",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-pgvector": "0.0.12",
    "@opennextjs/cloudflare": "^1.20.13",
    "better-auth": "^1.7.13",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "node-html-parser": "^9.0.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@10.25.0"
}
